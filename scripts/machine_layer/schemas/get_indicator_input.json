{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "american-default-mcp/v1/get_indicator_input.json",
  "title": "get_indicator input",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug"],
  "properties": {
    "slug": {
      "type": "string",
      "description": "Kebab-case indicator slug (e.g. 'the-buffer').",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    }
  }
}
